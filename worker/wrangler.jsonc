{
    "name": "weld-staff-api",
    "main": "src/index.ts",
    "compatibility_date": "2024-02-08",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "observability": {
        "enabled": true
    },
    // Tudo o que está aqui SUBSTITUI o que estiver no painel da Cloudflare a cada
    // `wrangler deploy` — uma variável mudada só no painel perde-se no deploy seguinte.
    "vars": {
        "ALLOWED_ORIGIN": "https://weldstaff.pt,https://weldstaff.com",
        // A caixa que envia (Hostinger Mail API). O Worker procura-a pelo endereço entre
        // as que o token vê, e recusa enviar se não a encontrar.
        "HOSTINGER_SENDER": "geral@weldstaff.pt"
    }
}
